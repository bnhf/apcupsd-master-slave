#!/bin/bash
# install-power-restore
# 2026.10.14
# Installs, updates or removes the power-restore-delay and power-restore-wait systemd units on the
# Docker host. Run it on the host from the apcupsd persistent directory, e.g.:
#   sudo /data/apcupsd/install-power-restore            (install, or change the delay values)
#   sudo /data/apcupsd/install-power-restore --remove   (uninstall)

FLAG_NAME=powerfail
PROJECT=apcupsd
SYSTEMD_DIR=/etc/systemd/system
MAX_SECONDS=600
DELAY_UNIT=power-restore-delay.service
WAIT_UNIT=power-restore-wait.service

# The persistent directory is wherever this script lives, which gives the host path of the flag
SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
FLAG_PATH="$SCRIPT_DIR/$FLAG_NAME"
SCRIPT_NAME=$(basename "$0")

usage() {
  cat <<EOF
Usage: sudo $SCRIPT_DIR/$SCRIPT_NAME [options]

Installs the $PROJECT power-restore units on this host, or changes their values when run again.

Options:
  --delay SECONDS   Boot delay (0-$MAX_SECONDS, 0 turns it off) -- skips the prompt
  --wait SECONDS    Docker wait limit (0-$MAX_SECONDS, 0 turns it off) -- skips the prompt
  --remove          Disable and remove both units
  --yes             Don't ask for confirmation (with --remove)
  -h, --help        Show this help
EOF
}

die() {
  echo "$SCRIPT_NAME: $1" >&2
  exit 1
}

# Read the seconds value from an installed unit's ExecStart line (sleep N or timeout N)
installedValue() {
  [ -f "$SYSTEMD_DIR/$1" ] || return 1
  grep '^ExecStart=' "$SYSTEMD_DIR/$1" | grep -oE "$2 [0-9]+" | head -1 | awk '{ print $2 }'
}

validSeconds() {
  [[ $1 =~ ^[0-9]+$ ]] && (( 10#$1 <= MAX_SECONDS ))
}

# Prompt for a value, keeping the current one on Enter
askSeconds() {
  local prompt=$1 current=$2 answer
  while :; do
    read -r -p "$prompt [$current]: " answer
    answer=${answer:-$current}
    if validSeconds "$answer"; then
      echo $(( 10#$answer ))
      return
    fi
    echo "  Please enter a whole number of seconds from 0 to $MAX_SECONDS." >&2
  done
}

removeUnit() {
  [ -f "$SYSTEMD_DIR/$1" ] || return 0
  systemctl disable -q "$1" 2>/dev/null
  rm -f "$SYSTEMD_DIR/$1"
  echo "Removed $1"
}

# Build an installed unit from the shipped copy in the persistent directory
writeUnit() {
  local unit=$1 seconds=$2 tmp
  tmp=$(mktemp) || die "can't create a temporary file"
  {
    echo "# Generated by $SCRIPT_DIR/$SCRIPT_NAME -- run it again to change the values"
    sed -e "s|^ConditionPathExists=.*|ConditionPathExists=$FLAG_PATH|" \
        -e "s|^RequiresMountsFor=.*|RequiresMountsFor=$SCRIPT_DIR|" \
        -e "s|flag --$|flag.|" \
        -e '/edit it if your HOST_DIR/d' \
        -e "s|/bin/sleep [0-9]*|/bin/sleep $seconds|" \
        -e "s|/usr/bin/timeout [0-9]*|/usr/bin/timeout $seconds|" \
        -e "s|^# Wait up to [^;]*;|# Wait up to ${seconds}s for DNS and NTP sync;|" \
        -e "s|^TimeoutStartSec=.*|TimeoutStartSec=$(( seconds + 30 ))|" \
        "$SCRIPT_DIR/$unit"
  } > "$tmp"
  install -m 644 "$tmp" "$SYSTEMD_DIR/$unit"
  rm -f "$tmp"
}

delay=""; wait=""; remove=false; assumeYes=false
while [ $# -gt 0 ]; do
  case $1 in
    --delay)   validSeconds "$2" || die "--delay needs a whole number of seconds from 0 to $MAX_SECONDS"; delay=$(( 10#$2 )); shift 2 ;;
    --wait)    validSeconds "$2" || die "--wait needs a whole number of seconds from 0 to $MAX_SECONDS"; wait=$(( 10#$2 )); shift 2 ;;
    --remove)  remove=true; shift ;;
    --yes|-y)  assumeYes=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *)         usage >&2; exit 1 ;;
  esac
done

# This script manages units on the Docker host, so it can't run inside a container
[ -f /.dockerenv ] || [ -f /run/.containerenv ] && die "run this on the Docker host, not inside the container"
[ "$(id -u)" -eq 0 ] || die "must be run as root -- try: sudo $SCRIPT_DIR/$SCRIPT_NAME $*"
[ -d /run/systemd/system ] || die "this host isn't running systemd, so the units can't be used"

if [ "$remove" == "true" ]; then
  if [ ! -f "$SYSTEMD_DIR/$DELAY_UNIT" ] && [ ! -f "$SYSTEMD_DIR/$WAIT_UNIT" ]; then
    echo "Neither unit is installed -- nothing to remove."
    exit 0
  fi
  if [ "$assumeYes" != "true" ]; then
    [ -t 0 ] || die "add --yes to remove without a prompt"
    read -r -p "Remove $DELAY_UNIT and $WAIT_UNIT from this host? [y/N]: " answer
    [[ $answer =~ ^[Yy] ]] || { echo "Nothing removed."; exit 0; }
  fi
  removeUnit "$DELAY_UNIT"
  removeUnit "$WAIT_UNIT"
  systemctl daemon-reload
  echo "Done -- both units are removed."
  exit 0
fi

systemdVersion=$(systemctl --version | awk 'NR == 1 { print $2 }')
[[ $systemdVersion =~ ^[0-9]+$ ]] && (( systemdVersion >= 239 )) \
  || die "systemd 239 or later is required (this host has ${systemdVersion:-an unknown version})"
systemctl cat docker.service >/dev/null 2>&1 \
  || die "docker.service wasn't found -- Docker must run as a systemd service named docker.service (snap installs aren't supported)"
for unit in "$DELAY_UNIT" "$WAIT_UNIT"; do
  [ -f "$SCRIPT_DIR/$unit" ] || die "$SCRIPT_DIR/$unit is missing -- start the $PROJECT container once to copy it here"
done

# Defaults: the installed values when re-running, otherwise the shipped values
if [ -f "$SYSTEMD_DIR/$DELAY_UNIT" ] || [ -f "$SYSTEMD_DIR/$WAIT_UNIT" ]; then
  currentDelay=$(installedValue "$DELAY_UNIT" sleep || echo 0)
  currentWait=$(installedValue "$WAIT_UNIT" timeout || echo 0)
else
  currentDelay=$(grep -oE 'sleep [0-9]+' "$SCRIPT_DIR/$DELAY_UNIT" | head -1 | awk '{ print $2 }')
  currentWait=$(grep -oE 'timeout [0-9]+' "$SCRIPT_DIR/$WAIT_UNIT" | head -1 | awk '{ print $2 }')
fi
currentDelay=${currentDelay:-60}; currentWait=${currentWait:-120}

if [ -z "$delay" ] || [ -z "$wait" ]; then
  if [ -t 0 ]; then
    echo "Power-restore units for $PROJECT -- runs after a power failure, when $FLAG_PATH exists."
    echo "Press Enter to keep the value in brackets. 0 turns that unit off."
  fi
fi
if [ -z "$delay" ]; then
  [ -t 0 ] && delay=$(askSeconds "Boot delay in seconds (fixed pause before networking starts)" "$currentDelay") || delay=$currentDelay
fi
if [ -z "$wait" ]; then
  [ -t 0 ] && wait=$(askSeconds "Docker wait limit in seconds (until DNS and the clock are ready)" "$currentWait") || wait=$currentWait
fi

if (( delay == 0 )) && (( wait == 0 )); then
  removeUnit "$DELAY_UNIT"
  removeUnit "$WAIT_UNIT"
  systemctl daemon-reload
  echo "Both values are 0, so both units are removed."
  exit 0
fi

if (( delay > 0 )); then writeUnit "$DELAY_UNIT" "$delay"; else removeUnit "$DELAY_UNIT"; fi
if (( wait > 0 )); then writeUnit "$WAIT_UNIT" "$wait"; else removeUnit "$WAIT_UNIT"; fi
systemctl daemon-reload

installed=()
(( delay > 0 )) && installed+=( "$SYSTEMD_DIR/$DELAY_UNIT" )
(( wait > 0 )) && installed+=( "$SYSTEMD_DIR/$WAIT_UNIT" )
systemctl enable -q "${installed[@]##*/}" || die "systemctl enable failed"
systemd-analyze verify "${installed[@]}" || echo "Warning: systemd-analyze reported problems with the units above" >&2

echo
echo "Installed for $PROJECT (flag: $FLAG_PATH):"
(( delay > 0 )) && echo "  $DELAY_UNIT  boot delay ${delay}s" || echo "  $DELAY_UNIT  off"
(( wait > 0 ))  && echo "  $WAIT_UNIT   Docker wait up to ${wait}s" || echo "  $WAIT_UNIT   off"
echo "The values take effect on the next power-failure boot. Run this script again to change them,"
echo "or with --remove to uninstall."
